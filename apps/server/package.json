{
  "name": "@doorbell/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "registration-code": "tsx src/registration-code-cli.ts",
    "bell:bind-first-household": "tsx src/bell-credential-cli.ts",
    "account:reset-password": "tsx src/reset-human-password.ts",
    "account:unlock": "tsx src/unlock-human-account.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@doorbell/protocol": "*",
    "@fastify/websocket": "11.3.0",
    "better-sqlite3": "13.0.2",
    "fastify": "5.11.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/ws": "8.18.1"
  }
}
